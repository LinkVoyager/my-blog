---
import { getAssetPath } from "@/utils/withBase";

const backgrounds = [
  { id: "city", label: "城市街景", src: getAssetPath("backgrounds/city.webp") },
];
---

<div class="relative flex items-center justify-center">
  <button
    id="background-btn"
    class="focus-outline hover:text-accent relative h-8 px-2 text-sm font-medium"
    type="button"
    aria-expanded="false"
    aria-controls="background-picker"
    aria-label="阅读设置"
    title="阅读设置"
  >
    阅读设置
  </button>
  <div
    id="background-picker"
    class="bg-background border-border absolute top-full right-0 z-30 mt-2 hidden w-64 rounded-lg border p-2 shadow-lg"
  >
    <p class="text-muted-foreground px-2 py-1 text-xs">背景与阅读显示</p>
    <div class="grid gap-1" role="listbox" aria-label="背景图片">
      {
        backgrounds.map(background => (
          <button
            type="button"
            class="background-option hover:bg-muted focus-outline flex items-center gap-2 rounded-md p-2 text-start text-sm"
            data-background-option={background.id}
            data-background-src={background.src}
            role="option"
            aria-label={background.label}
          >
            <span
              class="border-border size-12 shrink-0 rounded bg-cover bg-center"
              style={`background-image: url('${background.src}')`}
              aria-hidden="true"
            />
            <span>{background.label}</span>
          </button>
        ))
      }
    </div>
    <div class="border-border mt-2 border-t px-2 pt-3">
      <div class="mb-1 flex items-center justify-between gap-2 text-xs">
        <label for="background-opacity">图片透明度</label>
        <output id="background-opacity-value" for="background-opacity"
          >60%</output
        >
      </div>
      <input
        id="background-opacity"
        class="accent-accent w-full"
        type="range"
        min="0"
        max="100"
        step="1"
        value="60"
        aria-label="调整背景图片透明度"
      />
    </div>
  </div>
</div>

<script>
  const BACKGROUND_KEY = "blog-background";
  const OPACITY_KEY = "blog-background-opacity";
  const DEFAULT_BACKGROUND = "city";
  const DEFAULT_OPACITY = 60;

  function getOptions() {
    return Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-background-option]")
    );
  }

  function applyBackground(id: string, persist = true) {
    const option = getOptions().find(
      item => item.dataset.backgroundOption === id
    );
    if (!option) return;

    const root = document.documentElement;
    root.style.setProperty(
      "--site-background-image",
      `url("${option.dataset.backgroundSrc ?? ""}")`
    );
    root.dataset.background = id;

    getOptions().forEach(item => {
      const selected = item === option;
      item.setAttribute("aria-selected", String(selected));
      item.classList.toggle("ring-accent", selected);
      item.classList.toggle("ring-2", selected);
    });

    if (persist) localStorage.setItem(BACKGROUND_KEY, id);
  }

  function applyOpacity(value: number, persist = true) {
    const opacity = Math.min(100, Math.max(0, value));
    document.documentElement.style.setProperty(
      "--site-background-opacity",
      String(opacity / 100)
    );
    const slider = document.querySelector<HTMLInputElement>(
      "#background-opacity"
    );
    const output = document.querySelector<HTMLOutputElement>(
      "#background-opacity-value"
    );
    if (slider) slider.value = String(opacity);
    if (output) output.value = `${opacity}%`;
    if (persist) localStorage.setItem(OPACITY_KEY, String(opacity));
  }

  function setupBackgroundPicker() {
    const button = document.querySelector<HTMLButtonElement>("#background-btn");
    const picker = document.querySelector<HTMLElement>("#background-picker");
    const slider = document.querySelector<HTMLInputElement>(
      "#background-opacity"
    );
    if (!button || !picker || !slider) return;

    const savedBackground =
      localStorage.getItem(BACKGROUND_KEY) ?? DEFAULT_BACKGROUND;
    const backgroundId = getOptions().some(
      option => option.dataset.backgroundOption === savedBackground
    )
      ? savedBackground
      : DEFAULT_BACKGROUND;
    const savedOpacity = Number.parseInt(
      localStorage.getItem(OPACITY_KEY) ?? String(DEFAULT_OPACITY),
      10
    );
    applyBackground(backgroundId, false);
    applyOpacity(
      Number.isFinite(savedOpacity) ? savedOpacity : DEFAULT_OPACITY,
      false
    );

    if (button.dataset.bound !== "true") {
      button.dataset.bound = "true";
      button.addEventListener("click", () => {
        const open = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", String(!open));
        picker.classList.toggle("hidden", open);
      });

      getOptions().forEach(option => {
        option.addEventListener("click", () => {
          applyBackground(
            option.dataset.backgroundOption ?? DEFAULT_BACKGROUND
          );
          button.setAttribute("aria-expanded", "false");
          picker.classList.add("hidden");
        });
      });

      slider.addEventListener("input", () => {
        applyOpacity(Number(slider.value));
      });

      document.addEventListener("click", event => {
        if (!button.parentElement?.contains(event.target as Node)) {
          button.setAttribute("aria-expanded", "false");
          picker.classList.add("hidden");
        }
      });
    }
  }

  setupBackgroundPicker();
  document.addEventListener("astro:after-swap", setupBackgroundPicker);
</script>
